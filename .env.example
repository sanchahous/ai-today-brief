# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://aitodaybrief.com

# ── Supabase ────────────────────────────────────────────────────────────────
# The app (set these in Vercel). Same project as the pipeline = the existing ai-news DB.
# Client values are safe to expose: anon key is gated by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER prefix with NEXT_PUBLIC, never import under src/.
SUPABASE_SERVICE_ROLE_KEY=

# ── Pipeline / LLM (Node, server-only) ──────────────────────────────────────
# Supabase for the pipeline = SAME project as the app above, server-side names
# (these are the GitHub Actions secrets).
SCRAPPER_BASE_URL=
SCRAPPER_SERVICE_KEY=

# Required on Vercel too if you use Telegram /custom (webhook runs runCustomNews on Vercel).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL_FALLBACK=
INBRIEF_API_KEY=

# Card images — free per-item AI illustration (Cloudflare Workers AI FLUX).
# Account id + a token scoped to "Workers AI: Read". Unset ⇒ card-image step is
# skipped and the OG card renders its branded duotone fallback. Pollinations is
# used as a no-key fallback when CF is set but a single generation fails.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Reddit Data API — OFF until Reddit gives written approval for this business use.
# Set REDDIT_DATA_API_APPROVED=1 only after that approval; OAuth credentials alone
# never enable the source. The pipeline never falls back to public *.json scraping.
REDDIT_DATA_API_APPROVED=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Required for the identifying User-Agent: `web:ai-today-brief:1.1 (by /u/<username>)`.
REDDIT_USERNAME=

# ── Newsletter (Beehiiv API v2 — no custom domain on aitodaybrief.com) ─────
BEEHIIV_API_KEY=
# Canonical, or use dashboard labels:
BEEHIIV_PUBLICATION_ID=
# BEEHIIV_PUBLICATION_ID_API_V2=pub_…   ← preferred for v2 API
# BEEHIIV_PUBLICATION_ID_API_V1=uuid…
RESEND_API_KEY=

# ── Distribution ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Explicit allowlist. Default when omitted: telegram,x. Add `threads` only
# after its account/token smoke test succeeds; `none` pauses all public posts.
# SOCIAL_CHANNELS=telegram,x
# Long-lived Threads token. Never commit it or expose it to the browser.
THREADS_ACCESS_TOKEN=

# ── Editorial review (per-item approve/reject in a private Telegram chat) ────
# Private chat id that receives the review cards (set ⇒ pipeline pushes them).
TELEGRAM_REVIEW_CHAT_ID=
# Only this Telegram user id may approve/reject (webhook allowlist).
TELEGRAM_ADMIN_USER_ID=
# Secret echoed back in the X-Telegram-Bot-Api-Secret-Token header on the webhook.
TELEGRAM_WEBHOOK_SECRET=

# ── Payments (Merchant of Record — Stripe is blocked in UA) ─────────────────
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ── Analytics (public IDs — safe in client bundle) ──────────────────────────
# GA4 measurement ID (direct gtag events + Consent Mode).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Tag Manager container (deferred loader for PageSpeed).
NEXT_PUBLIC_GTM_ID=
# Reader Revenue Manager product ID from Publisher Center (format "CAow…:openaccess").
# Empty ⇒ the swg-basic.js snippet is not rendered at all.
NEXT_PUBLIC_SWG_PRODUCT_ID=

# ── On-publish revalidation (pipeline → Next ISR) ───────────────────────────
REVALIDATE_SECRET=

# ── IndexNow (instant recrawl ping — Bing/Yandex, NOT Google) ────────────────
# Public key; served at /indexnow-key.txt and sent as keyLocation on publish.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Set the SAME value in Vercel (app ping) and the pipeline env (backfill script).
# Unset ⇒ pinging is off and /indexnow-key.txt returns 404.
INDEXNOW_KEY=

# ── Sonar (local report only — never commit a real token) ───────────────────
# SONAR_TOKEN=
# SONAR_HOST_URL=https://sonarcloud.io
