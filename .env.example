# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://aitodaybrief.com

# ── Supabase ────────────────────────────────────────────────────────────────
# The app (set these in Vercel). Same project as the pipeline = the existing ai-news DB.
# Client values are safe to expose: anon key is gated by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER prefix with NEXT_PUBLIC, never import under src/.
SUPABASE_SERVICE_ROLE_KEY=

# ── Social CMS owner / scheduler (server-only) ─────────────────────────────
# Existing Supabase Auth users only; comma-separated. The first successful
# login bootstraps the matching user into social_admins as owner.
SOCIAL_ADMIN_EMAILS=
# 32+ random bytes. Supabase Cron sends this as `Authorization: Bearer …`.
SOCIAL_CRON_SECRET=
# Separate HMAC secret for LinkedIn/Meta/Threads OAuth state (may fall back to
# SOCIAL_CRON_SECRET, but a separate value is preferred).
OAUTH_STATE_SECRET=
# Model-independent social generation and audit. Defaults deliberately use
# different first providers: writer Gemini → OpenRouter → Ollama; critic
# OpenRouter → Gemini → Ollama. Model ids come from live provider catalogs and
# are restricted to the current generation. Pins are optional and validated.
# SOCIAL_WRITER_PROVIDER_ORDER=gemini,openrouter,ollama
# SOCIAL_CRITIC_PROVIDER_ORDER=openrouter,gemini,ollama
# SOCIAL_WRITER_GEMINI_MODEL=
# SOCIAL_CRITIC_GEMINI_MODEL=
# SOCIAL_WRITER_OPENROUTER_MODELS=
# SOCIAL_CRITIC_OPENROUTER_MODELS=
# Block approval when all critic providers fail (recommended in production).
SOCIAL_CRITIC_REQUIRED=true
SOCIAL_CRITIC_MIN_SCORE=85
# Local/manual terminal fallback. Vercel cannot reach a loopback endpoint.
# SOCIAL_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/
# SOCIAL_OLLAMA_MODEL=
# SOCIAL_OLLAMA_API_KEY= # required for a remote HTTPS endpoint

# ── Pipeline / LLM (Node, server-only) ──────────────────────────────────────
# Supabase for the pipeline = SAME project as the app above, server-side names
# (these are the GitHub Actions secrets).
SCRAPPER_BASE_URL=
SCRAPPER_SERVICE_KEY=

# Required on Vercel too if you use Telegram /custom (webhook runs runCustomNews on Vercel).
GEMINI_API_KEY=
# Optional pin within the current live generation; stale pins are ignored.
# GEMINI_MODEL=
# OpenRouter is the independent cloud fallback for pipeline and CMS LLM calls.
OPEN_ROUTER_API_KEY=
# Daily job (rerank-openrouter-models.yml, F3) reranks OpenRouter's default
# provider queue by quality/$. Set to "off" to keep it writing audit rows
# without ever calling replace_llm_provider_models -- a reversible kill-switch,
# no deploy needed. Unset or anything else ⇒ apply stays enabled.
# OPENROUTER_RERANK_APPLY=
INBRIEF_API_KEY=

# Card images — per-item AI illustration via Cloudflare Workers AI.
# Account id + a token scoped to "Workers AI: Read". Unset ⇒ card-image step is
# skipped and the OG card renders its branded duotone fallback. Pollinations is
# used as a no-key fallback when CF is set but a single generation fails.
# Default model: @cf/black-forest-labs/flux-2-klein-9b (multipart). Override to
# try flux-2-dev without a code change. Spillover: flux-1-schnell.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b
# Klein Unit Pricing estimate for /admin/costs (first MP + subsequent MPs).
# CLOUDFLARE_IMAGE_USD_FIRST_MP=0.015
# CLOUDFLARE_IMAGE_USD_NEXT_MP=0.002
# Optional Gemini image tier (e.g. gemini-3-pro-image). Empty ⇒ start at Cloudflare.
# GEMINI_IMAGE_MODEL=

# Reddit Data API — OFF until Reddit gives written approval for this business use.
# Set REDDIT_DATA_API_APPROVED=1 only after that approval; OAuth credentials alone
# never enable the source. The pipeline never falls back to public *.json scraping.
REDDIT_DATA_API_APPROVED=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Required for the identifying User-Agent: `web:ai-today-brief:1.1 (by /u/<username>)`.
REDDIT_USERNAME=

# ── Newsletter (Beehiiv API v2 — no custom domain on aitodaybrief.com) ─────
BEEHIIV_API_KEY=
# Canonical, or use dashboard labels:
BEEHIIV_PUBLICATION_ID=
# BEEHIIV_PUBLICATION_ID_API_V2=pub_…   ← preferred for v2 API
# BEEHIIV_PUBLICATION_ID_API_V1=uuid…
RESEND_API_KEY=

# ── Distribution ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Optional dedicated bot and destination for public CMS publishing. When set,
# they override the two TELEGRAM_* values above for publishing only.
PUBLISHER_TELEGRAM_BOT_TOKEN=
PUBLISHER_TELEGRAM_CHANNEL_ID=
# Explicit allowlist. Default when omitted: telegram,x. Add `threads` only
# after its account/token smoke test succeeds; `none` pauses all public posts.
# SOCIAL_CHANNELS=telegram,x
# Long-lived Threads token. Never commit it or expose it to the browser.
THREADS_ACCESS_TOKEN=
# OAuth app credentials (refreshable tokens are encrypted in Supabase Vault).
THREADS_APP_ID=
THREADS_APP_SECRET=

# X uses static OAuth 1.0a app-owner credentials. The DB hard cap is at most
# €10/month; this conservative reservation covers root + self-reply.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_POST_ESTIMATED_COST_EUR=0.40

# LinkedIn Company Posts API. Until Standard access is approved, the CMS keeps
# the export/native-scheduler fallback available.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_URN=
# Add offline_access only if LinkedIn approved it for this application.
LINKEDIN_OAUTH_SCOPES=w_organization_social
# YYYYMM; update only after validating the current LinkedIn API version.
LINKEDIN_VERSION=202607

# Facebook Page + Instagram Business account through one Meta application.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# ── Editorial review (per-item approve/reject in a private Telegram chat) ────
# Private chat id that receives the review cards (set ⇒ pipeline pushes them).
TELEGRAM_REVIEW_CHAT_ID=
# Only this Telegram user id may approve/reject (webhook allowlist).
TELEGRAM_ADMIN_USER_ID=
# Secret echoed back in the X-Telegram-Bot-Api-Secret-Token header on the webhook.
TELEGRAM_WEBHOOK_SECRET=

# ── Payments (Merchant of Record — Stripe is blocked in UA) ─────────────────
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ── Analytics (public IDs — safe in client bundle) ──────────────────────────
# GA4 measurement ID — the single collection tag for the site (direct gtag).
# The GTM container GTM-5S6TXPG5 was removed on 2026-08-22: it had zero tags
# and no GA4 destination, so it only added a dead second ID to every page.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Reader Revenue Manager product ID from Publisher Center (format "CAow…:openaccess").
# Empty ⇒ the swg-basic.js snippet is not rendered at all.
NEXT_PUBLIC_SWG_PRODUCT_ID=

# ── On-publish revalidation (pipeline → Next ISR) ───────────────────────────
REVALIDATE_SECRET=

# ── IndexNow (instant recrawl ping — Bing/Yandex, NOT Google) ────────────────
# Public key; served at /indexnow-key.txt and sent as keyLocation on publish.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Set the SAME value in Vercel (app ping) and the pipeline env (backfill script).
# Unset ⇒ pinging is off and /indexnow-key.txt returns 404.
INDEXNOW_KEY=

# ── Weekly Digest Content Studio v2 ─────────────────────────────────────────
# off | shadow | production. Start with shadow for three historical editions.
WEEKLY_CONTENT_STUDIO_V2=off
# Digest illustrations: prompt_only (default) writes copy-ready prompts and waits
# for owner upload. render restores the old FLUX + vision loop without a deploy.
WEEKLY_STORY_IMAGE_MODE=prompt_only
# Premium master providers must include two independent families.
WEEKLY_MASTER_PROVIDER_ORDER=openrouter,gemini
WEEKLY_MASTER_OPENROUTER_MODELS=
WEEKLY_MASTER_GEMINI_MODEL=
# How many value-ranked OpenRouter models the master write may try in one
# call. Default 1 — a second attempt does not fit Vercel's 300s budget. The
# GitHub Actions worker has no such limit and sets 3, so one model returning
# malformed JSON no longer kills the whole job.
WEEKLY_MASTER_OPENROUTER_CANDIDATES=1
# ── Iterative master engine (src/lib/weekly-digest/master-engine.ts) ────────
# The master is written as one call per story plus one per locale frame, each
# checkpointed durably, then repaired field by field instead of regenerated.
# A run that cannot clear every check finishes as SUCCEEDED with an inactive
# draft revision for owner review — quality never fails the job.
#
# Attempts one field may get before it is reported unresolved (default 3).
WEEKLY_MASTER_MAX_REPAIR_ATTEMPTS=
# critic → repair → critic cycles per run (default 3).
WEEKLY_MASTER_MAX_CRITIC_ROUNDS=
# Free deterministic validate → repair cycles run BEFORE the first paid critic
# call (default 3). These fix metadata length, template leaks, numeric parity
# and Ukrainian language residue for cents, so the critic never rejects a
# draft over something a regular expression already knew about.
WEEKLY_MASTER_MAX_DETERMINISTIC_ROUNDS=
# Fields repaired per round (default 12).
WEEKLY_MASTER_MAX_REPAIRS_PER_ROUND=
# Wall-clock budget for one run (ms, default 95 minutes — the Actions job
# allows 120). On expiry the run stops, keeps every finished segment on the
# job row and reports a resumable failure; the retry continues from there.
WEEKLY_MASTER_DEADLINE_MS=
# ── Content simulation / backtest (src/lib/content-sim) ─────────────────────
# Vision critic + auto-repair for weekly/daily images before release.
# Total image rounds: initial diagnosis + one decisive re-plan (hard-capped at 2).
CONTENT_SIM_MAX_IMAGE_REPAIR=2
# Overall vision score threshold 0–100 (default 80).
CONTENT_SIM_SCORE_THRESHOLD=80
# Soft USD cap per image loop (gen + critic), news branch only. Do not raise
# for weekly — digest images are owner-manual (prompt_only). Hard-capped at 0.2.
CONTENT_SIM_MAX_IMAGE_SPEND_USD=0.2
# Estimated USD booked per vision critic call when provider omits cost.
CONTENT_SIM_VISION_CRITIC_USD=0.01
# off|0|false disables the vision repair loop (generate once, no critic).
CONTENT_SIM_IMAGE_LOOP=
# Optional vision model overrides (else GEMINI_MODEL / OpenRouter flash).
CONTENT_SIM_VISION_GEMINI_MODEL=
CONTENT_SIM_VISION_OPENROUTER_MODEL=
# Hard ceiling for one `claude -p` generation (ms). Default 20 minutes: a
# full master write is a single ~20k-output-token answer, and the previous
# 4-minute ceiling was silently SIGTERMing healthy runs.
CLAUDE_CLI_TIMEOUT_MS=
# Same ceiling for the generic CLI-provider skeleton (codex-cli et al.).
CLI_PROVIDER_TIMEOUT_MS=
# Local sandbox only: 1 ⇒ use the `claude` binary's own interactive login
# instead of requiring CLAUDE_CODE_OAUTH_TOKEN. Never set this on a runner.
CLAUDE_CLI_USE_LOCAL_AUTH=
WEEKLY_LLM_INPUT_USD_PER_MILLION=3
WEEKLY_LLM_OUTPUT_USD_PER_MILLION=15
# Fallback social writer/critic rates, used only when a provider reports tokens
# but no cost. OpenRouter reports real cost and that is what the ledger books.
SOCIAL_LLM_INPUT_USD_PER_MILLION=0.3
SOCIAL_LLM_OUTPUT_USD_PER_MILLION=1
# Hard price ceiling for the social lane: blended USD per million tokens
# (input weighted 9:1, matching a prompt-heavy social call). A model above it
# never enters a writer/critic queue, and a model that publishes no price is
# excluded rather than assumed free. Owner set 1.5 on 2026-08-29: this keeps the
# efficient writer lanes but also drops the critic's two former leads, so the
# critic now audits on cheaper families. Raise toward 3.0 to get them back.
SOCIAL_LLM_MAX_PRICE_PER_MILLION=1.5
# Circuit breaker: metered provider spend allowed in a rolling 24h window
# across every generation job (weekly + social + images). Subscription work
# (Claude CLI) does not count. A job that would start over this ceiling is
# refused before the provider call. Unlike WEEKLY_MASTER_MAX_SPEND_USD this is
# global and does not reset when a retry opens a new revision — the gap that
# let 190 OpenRouter calls / $8.74 through on 2026-08-28. Default 5 is a
# starting figure: retune it once the ledger has run truthful for a full cycle.
DAILY_GENERATION_BUDGET_USD=5
# Private server-side salt; never expose this with NEXT_PUBLIC_.
WEEKLY_ANALYTICS_SALT=
# Fine-grained GitHub PAT (Actions: read and write, this repo only) so the
# admin "Write master via Claude subscription" button can dispatch the
# weekly-master-cli-worker workflow. Not required for the OpenRouter path.
GH_ACTIONS_DISPATCH_TOKEN=

# ── Sonar (local report only — never commit a real token) ───────────────────
# SONAR_TOKEN=
# SONAR_HOST_URL=https://sonarcloud.io
