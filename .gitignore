# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# local clones / reports
.tmp-portfolio/
.tmp-browse/
sonar-report.md

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# sonar
.scannerwork/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only pipeline ops/debug helpers (underscore-prefixed, not for CI)
pipeline/scripts/_*

# generated card-image samples / OG render checks (large binaries — regenerate locally)
artifacts/card-samples/

# knowledge layer: local-only zone for bulk media, scrape dumps, PII or
# licence-restricted sources. Everything else under raw/ and artifacts/ IS tracked.
raw/_local/*
!raw/_local/.gitkeep
artifacts/_local/*
!artifacts/_local/.gitkeep
