{
  "name": "ai-today-brief",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:logic-lcov": "npx tsx scripts/verify-logic-lcov.ts",
    "verify:coverage": "npm run test:coverage && npm run verify:logic-lcov",
    "ci:check": "npm run verify:coverage",
    "sonar:report": "npx tsx scripts/sonar-fetch-report.ts",
    "wiki:lint": "node wiki/_tools/wiki-lint.mjs",
    "wiki:sync": "node wiki/_tools/wiki-project-sync.mjs",
    "wiki:sync:test": "node --test wiki/_tools/wiki-project-sync.test.mjs",
    "wiki:check": "npm run wiki:sync && npm run wiki:sync:test && node wiki/_tools/wiki-lint.mjs --strict",
    "icons:generate": "npx tsx scripts/generate-brand-icons.ts",
    "pipeline": "tsx pipeline/run-daily.ts",
    "pipeline:dry": "tsx pipeline/run-daily.ts --dry-run",
    "custom-news": "tsx pipeline/scripts/custom-news.ts",
    "backfill:concepts": "tsx pipeline/scripts/backfill-concepts.ts",
    "backfill:scores": "tsx pipeline/scripts/backfill-scores.ts",
    "backfill:trend-signals": "tsx pipeline/scripts/backfill-trend-signals.ts",
    "indexnow:backfill": "tsx pipeline/scripts/indexnow-backfill.ts",
    "auto:publish": "tsx pipeline/scripts/auto-publish.ts",
    "social:shadow": "node --conditions=react-server --import tsx scripts/social-shadow.ts",
    "social:asset:sample": "node --conditions=react-server --import tsx scripts/render-social-asset-sample.ts",
    "weekly:pdf:sample": "node --conditions=react-server --import tsx scripts/render-weekly-pdf-sample.ts",
    "weekly:pdf:trace": "tsx scripts/verify-weekly-pdf-preview-trace.ts",
    "weekly:master-cli-worker": "node --conditions=react-server --import tsx pipeline/scripts/run-weekly-master-cli-worker.ts",
    "pr:check": "npm run ci:check && npm run typecheck && npm run lint && npm run e2e:check && npm run wiki:check && npm run build",
    "e2e": "playwright test",
    "e2e:fast": "playwright test --project=chromium",
    "e2e:affected": "tsx scripts/e2e-affected.ts",
    "e2e:check": "tsx scripts/e2e-affected.ts --check",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "0.1.100",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "next": "^16.2.11",
    "pdf-to-img": "^6.2.0",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pdfkit": "^0.17.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "brace-expansion": "1.1.16",
    "postcss": "8.5.20",
    "sharp": "0.35.3"
  }
}
