{
  "name": "ai-today-brief",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:logic-lcov": "npx tsx scripts/verify-logic-lcov.ts",
    "verify:coverage": "npm run test:coverage && npm run verify:logic-lcov",
    "ci:check": "npm run verify:coverage",
    "sonar:report": "npx tsx scripts/sonar-fetch-report.ts",
    "pipeline": "tsx pipeline/run-daily.ts",
    "pipeline:dry": "tsx pipeline/run-daily.ts --dry-run",
    "custom-news": "tsx pipeline/scripts/custom-news.ts",
    "backfill:concepts": "tsx pipeline/scripts/backfill-concepts.ts",
    "backfill:scores": "tsx pipeline/scripts/backfill-scores.ts",
    "backfill:trend-signals": "tsx pipeline/scripts/backfill-trend-signals.ts",
    "pr:check": "npm run ci:check && npm run typecheck && npm run lint && npm run e2e:check && npm run build",
    "e2e": "playwright test",
    "e2e:fast": "playwright test --project=chromium",
    "e2e:affected": "tsx scripts/e2e-affected.ts",
    "e2e:check": "tsx scripts/e2e-affected.ts --check",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.108.2",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.7"
  }
}
