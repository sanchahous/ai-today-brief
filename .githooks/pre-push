#!/usr/bin/env sh
# Pre-push gate: `npm run check:affected` — only the checks this branch's changed paths need
# (map: scripts/check-scope.mjs). A wiki-only push runs wiki:check; a component change runs
# typecheck, eslint on that file, related unit tests, the design ratchet and the affected
# e2e specs on chromium; a dependency/config/unknown path runs the full suite.
# If the same tree already passed (you ran check:affected before pushing), it returns at once.
#
# Activated via `core.hooksPath=.githooks` (set by the `prepare` npm script on install).
# Escape hatches:
#   SKIP_E2E=1 git push      — everything except Playwright
#   SKIP_CHECKS=1 git push   — nothing (CI still runs the same map on the PR)
if [ "${SKIP_CHECKS:-0}" = "1" ]; then
  echo "pre-push: SKIP_CHECKS=1 — skipping check:affected."
  exit 0
fi

echo "pre-push: running check:affected. SKIP_E2E=1 skips Playwright, SKIP_CHECKS=1 skips all."
npm run check:affected
